{
  "name": "svnkit",
  "version": "1.0.0",
  "description": "SVN/Git 图形化版本管理工具（浏览器界面，双引擎并发防护）",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.web.json && node scripts/build-web.mjs",
    "start": "node dist/main.js",
    "dev": "npm run build && node scripts/dev.mjs",
    "clean": "rm -rf dist",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "highlight.js": "^11.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
