{
  "name": "svngit",
  "version": "1.0.0",
  "description": "SVN/Git 图形化版本管理工具（浏览器界面，双引擎并发防护）",
  "desktopName": "svngit",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.web.json && node scripts/build-web.mjs",
    "start": "node dist/main.js",
    "dev": "npm run build && node scripts/dev.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "npm run build && node test/vcs-test.mjs && node test/vcs-extra-test.mjs && node test/diff-lines-test.mjs && node test/diff-parse-test.mjs && node test/api-test.mjs && node test/upload-test.mjs",
    "test:e2e": "node test/e2e-smoke.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
